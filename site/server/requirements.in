# Runtime dependencies for the Study Hubs server (M0, M1, M2, M3).
# Direct dependencies are pinned exactly; requirements.txt is compiled from this
# file with hashes (see pyproject.toml / README.md for the command).
fastapi==0.141.1
uvicorn==0.54.0
# uvicorn picks these up automatically: a faster HTTP parser and event loop.
httptools==0.8.0
uvloop==0.22.1 ; sys_platform != "win32"
# IANA zone data for zoneinfo (the slim Docker image has no system tzdata).
tzdata==2026.4
# M1: Firebase Auth session cookies (firebase_admin.auth) and the Firestore store.
# google-cloud-firestore is imported directly (transactions, field masks, Increment),
# so it is pinned here as well instead of only arriving through firebase-admin.
firebase-admin==7.7.0
google-cloud-firestore==2.32.0
# M2: .backup encryption (AES-256-GCM frames, scrypt). Already locked through
# firebase-admin (PyJWT[crypto]); pinned here because the backup code imports it.
cryptography==50.0.1
# M3: the Postgres store (STORE=postgres): psycopg 3 with its binary wheel and the pool.
psycopg[binary,pool]==3.3.6
psycopg-binary==3.3.6
psycopg-pool==3.3.3
